{
  "version": 8,
  "name": "OSM Liberty",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "tiles": ["http://localhost:3000/openmaptiles/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 14,
      "center": [52, 36]
    }
  },

  "glyphs": "http://localhost:3000/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "rgb(239,239,239)" }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#d8e8c8",
        "fill-opacity": 0.7,
        "fill-outline-color": "rgba(95, 208, 100, 1)"
      }
    },
    {
      "id": "park_outline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "line-dasharray": [1, 1.5],
        "line-color": "rgba(228, 241, 215, 1)"
      }
    },
    {
      "id": "landuse_residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "minzoom": 10,
      "filter": ["==", "class", "residential"],
      "paint": {
        "fill-color": {
          "base": 1,
          "stops": [
            [9, "hsla(0, 3%, 85%, 0.84)"],
            [12, "hsla(35, 57%, 88%, 0.49)"]
          ]
        }
      }
    },
    {
      "id": "landcover_wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "wood", "forest"],
      "paint": {
        "fill-antialias": false,
        "fill-color": "hsla(98, 61%, 72%, 0.7)",
        "fill-opacity": 1
      }
    },
    {
      "id": "landcover_grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["all", ["==", "class", "grass"]],
      "paint": {
        "fill-antialias": false,
        "fill-color": "rgba(176, 213, 154, 1)",
        "fill-opacity": 0.3
      }
    },
    {
      "id": "landuse_cemetery",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "cemetery"],
      "paint": { "fill-color": "hsl(75, 37%, 81%)" }
    },
    {
      "id": "landuse_hospital",
      "type": "fill",
      "source": "openmaptiles",
      "minzoom": 10,
      "source-layer": "landuse",
      "filter": ["==", "class", "hospital"],
      "paint": { "fill-color": "#fde" }
    },
    {
      "id": "landuse_school",
      "type": "fill",
      "source": "openmaptiles",
      "minzoom": 10,
      "source-layer": "landuse",
      "filter": ["==", "class", "school"],
      "paint": { "fill-color": "#fff9c4" }
    },
    {
      "id": "waterway_river",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 9,
      "filter": ["==", "class", "river"],
      "layout": { "line-cap": "round" },
      "paint": {
        "line-color": "#a0c8f0",
        "line-width": {
          "base": 1.2,
          "stops": [
            [11, 1],
            [20, 6]
          ]
        }
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#00F",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "road_tunks",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["in", "class", "trunk", "primary", "motorway"]],
      "layout": { "line-join": "round" },
      "paint": {
        "line-color": "#e9ac77",
        "line-dasharray": [0.5, 0.25],
        "line-width": {
          "base": 1.2,
          "stops": [
            [12, 1],
            [13, 3],
            [14, 4],
            [20, 15]
          ]
        }
      }
    },
    {
      "id": "road_secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["in", "class", "secondary"]],
      "layout": { "line-join": "round" },
      "minzoom": 8,
      "paint": {
        "line-color": "#fff4c6",
        "line-width": {
          "base": 1.2,
          "stops": [
            [6.5, 0],
            [7, 0.5],
            [20, 10]
          ]
        }
      }
    },
    {
      "id": "road_tertiary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["in", "class", "tertiary"]],
      "layout": { "line-join": "round" },
      "minzoom": 8,
      "paint": {
        "line-color": "#e9ac77",
        "line-width": {
          "base": 1.2,
          "stops": [
            [8, 1.5],
            [20, 17]
          ]
        }
      }
    },
    {
      "id": "road_residential",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["in", "class", "residential"]],
      "layout": { "line-join": "round" },
      "minzoom": 8,
      "paint": {
        "line-color": "#f9ac77",
        "line-width": {
          "base": 1,
          "stops": [
            [8, 1.5],
            [20, 17]
          ]
        }
      }
    },
    {
      "id": "railway-rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "railway",
      "layout": { "line-join": "round" },
      "filter": ["==", "railway", "rail"],
      "paint": {
        "line-color": "#888",
        "line-dasharray": [2, 4],
        "line-width": 2
      }
    },
    {
      "id": "railway-subway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "railway",
      "filter": ["==", "railway", "subway"],
      "minzoom": 10,
      "layout": { "line-join": "round" },
      "paint": {
        "line-color": "#f00",
        "line-dasharray": [2, 4],
        "line-width": 2
      }
    },

    {
      "id": "country_name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "country",
      "filter": ["!=", ["get", "name"], ""],
      "layout": {
        "text-field": "{name}",
        "text-font": ["B Yekan Regular"],
        "text-max-width": 10,
        "text-size": 14,
        "symbol-placement": "line",
        "symbol-spacing": 350,
        "text-padding": 5
      },
      "paint": {
        "text-color": "#5d60be",
        "text-halo-color": "rgba(255,255,255,0.7)",
        "text-halo-width": 1
      }
    },
    {
      "id": "waterway_name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": ["!=", ["get", "name"], ""],
      "layout": {
        "text-field": "{name}",
        "text-font": ["B Yekan Regular"],
        "text-max-width": 10,
        "text-size": 13,
        "symbol-placement": "line",
        "symbol-spacing": 350,
        "text-padding": 5
      },
      "minzoom": 10,
      "paint": {
        "text-color": "#5d60be",
        "text-halo-color": "rgba(255,255,255,0.7)",
        "text-halo-width": 1
      }
    },
    {
      "id": "water_name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "name"], ""],
      "layout": {
        "text-field": "{name}",
        "text-font": ["B Yekan Regular"],
        "text-max-width": 10,
        "text-size": 13,
        "symbol-placement": "line",
        "symbol-spacing": 350,
        "text-padding": 5
      },
      "paint": {
        "text-color": "#5d60be",
        "text-halo-color": "rgba(255,255,255,0.7)",
        "text-halo-width": 1
      }
    },
    {
      "id": "road_name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["!=", ["get", "name"], ""],
      "layout": {
        "text-field": "{name}",
        "text-font": ["B Yekan Regular"],
        "text-max-width": 10,
        "text-size": 13,
        "symbol-placement": "line",
        "symbol-spacing": 350,
        "text-padding": 5
      },
      "paint": {
        "text-color": "#000",
        "text-halo-color": "rgba(255,255,255,0.7)",
        "text-halo-width": 1
      }
    },
    {
      "id": "landuse_name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["!=", ["get", "name"], ""],
      "layout": {
        "text-field": "{name}",
        "text-font": ["B Yekan Regular"],
        "text-max-width": 10,
        "text-size": 13,
        "symbol-spacing": 350,
        "text-padding": 5
      },
      "minzoom": 8,
      "paint": {
        "text-color": "#000",
        "text-halo-color": "rgba(255,255,255,0.7)",
        "text-halo-width": 1
      }
    },
    {
      "id": "park_name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "park",
      "filter": ["!=", ["get", "name"], ""],
      "layout": {
        "text-field": "{name}",
        "text-font": ["B Yekan Regular"],
        "text-max-width": 10,
        "text-size": 13,
        "symbol-spacing": 350,
        "text-padding": 5
      },
      "minzoom": 8,
      "paint": {
        "text-color": "#000",
        "text-halo-color": "rgba(255,255,255,0.7)",
        "text-halo-width": 1
      }
    },
    {
      "id": "landcover_name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["!=", ["get", "name"], ""],
      "layout": {
        "text-field": "{name}",
        "text-font": ["B Yekan Regular"],
        "text-max-width": 10,
        "text-size": 13,
        "symbol-spacing": 350,
        "text-padding": 5
      },
      "minzoom": 8,
      "paint": {
        "text-color": "#000",
        "text-halo-color": "rgba(255,255,255,0.7)",
        "text-halo-width": 1
      }
    },
    {
      "id": "railway_name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "railway",
      "filter": ["!=", ["get", "name"], ""],
      "layout": {
        "text-field": "{name}",
        "text-font": ["B Yekan Regular"],
        "text-max-width": 10,
        "text-size": 13,
        "symbol-spacing": 350,
        "text-padding": 5
      },
      "minzoom": 12,
      "paint": {
        "text-color": "#000",
        "text-halo-color": "rgba(255,255,255,0.7)",
        "text-halo-width": 1
      }
    }
  ],
  "id": "osm-liberty"
}
