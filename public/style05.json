{
  "version": 8,
  "name": "OSM Carto Style",
  "glyphs": "http://localhost:3000/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "tiles": ["http://localhost:3000/openmaptiles/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 14,
      "center": [52, 36]
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f2efe9" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#cceeff",
        "fill-opacity": 1
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#c5e1a5",
        "fill-opacity": 0.7,
        "fill-outline-color": "#a5d6a7"
      }
    },
    {
      "id": "landuse_residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "minzoom": 10,
      "filter": ["==", "class", "residential"],
      "paint": {
        "fill-color": "#e0dfdf"
      }
    },
    {
      "id": "landcover_wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "wood", "forest"],
      "paint": {
        "fill-color": "#c5e1a5",
        "fill-opacity": 1
      }
    },
    {
      "id": "landcover_grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "grass"],
      "paint": {
        "fill-color": "#d0f0c0",
        "fill-opacity": 0.3
      }
    },
    {
      "id": "landuse_cemetery",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "cemetery"],
      "paint": { "fill-color": "#c8e6c9" }
    },
    {
      "id": "landuse_hospital",
      "type": "fill",
      "source": "openmaptiles",
      "minzoom": 10,
      "source-layer": "landuse",
      "filter": ["==", "class", "hospital"],
      "paint": { "fill-color": "#f8bbd0" }
    },
    {
      "id": "landuse_school",
      "type": "fill",
      "source": "openmaptiles",
      "minzoom": 10,
      "source-layer": "landuse",
      "filter": ["==", "class", "school"],
      "paint": { "fill-color": "#fff9c4" }
    },
    {
      "id": "road_residential",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "residential", "unclassified"],
      "paint": {
        "line-color": "#F8F8F8",
        "line-width": {
          "base": 1,
          "stops": [
            [5, 1],
            [10, 3],
            [14, 6],
            [18, 12]
          ]
        },
        "line-opacity": 1
      }
    },
    {
      "id": "road_tertiary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "tertiary"],
      "paint": {
        "line-color": "#F8F8F8",
        "line-width": {
          "base": 1,
          "stops": [
            [5, 1],
            [10, 3],
            [14, 6],
            [18, 12]
          ]
        },
        "line-opacity": 1
      }
    },
    {
      "id": "railway-rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "railway",
      "filter": ["==", "railway", "rail"],
      "paint": {
        "line-color": "#444444",
        "line-dasharray": [2, 4],
        "line-width": 2
      }
    },
    {
      "id": "road_secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "secondary"],
      "paint": {
        "line-color": "#FFFFC0",
        "line-width": 2
      }
    },
    {
      "id": "road_primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "paint": {
        "line-color": "#FFDD00",
        "line-width": {
          "base": 2,
          "stops": [
            [5, 1],
            [10, 3],
            [14, 6],
            [18, 12]
          ]
        },
        "line-opacity": 1
      }
    },
    {
      "id": "road_motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "trunk",
      "paint": {
        "line-color": "#FF8000",
        "line-width": {
          "base": 2,
          "stops": [
            [5, 1],
            [10, 3],
            [14, 6],
            [18, 12]
          ]
        },
        "line-opacity": 1
      }
    },

    {
      "id": "country_name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "country",
      "filter": ["!=", ["get", "name"], ""],
      "layout": {
        "text-field": "{name}",
        "text-font": ["B Yekan Regular"],
        "text-size": 14,
        "text-anchor": "center",
        "text-justify": "center",
        "symbol-placement": "point",
        "text-max-width": 8,
        "symbol-spacing": 400,
        "text-padding": 4
      },
      "paint": {
        "text-color": "#444444",
        "text-halo-color": "#f2efe9",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "waterway_name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": ["!=", ["get", "name"], ""],
      "minzoom": 10,
      "layout": {
        "text-field": "{name}",
        "text-font": ["B Yekan Regular"],
        "text-size": 13,
        "text-anchor": "center",
        "text-justify": "center",
        "symbol-placement": "line",
        "text-max-width": 8,
        "symbol-spacing": 400,
        "text-padding": 4
      },
      "paint": {
        "text-color": "#6699cc",
        "text-halo-color": "#f2efe9",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "water_name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "name"], ""],
      "layout": {
        "text-field": "{name}",
        "text-font": ["B Yekan Regular"],
        "text-size": 13,
        "text-anchor": "center",
        "text-justify": "center",
        "symbol-placement": "point",
        "text-max-width": 8,
        "symbol-spacing": 400,
        "text-padding": 4
      },
      "paint": {
        "text-color": "#6699cc",
        "text-halo-color": "#f2efe9",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "road_name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["!=", ["get", "name"], ""],
      "layout": {
        "text-field": "{name}",
        "text-font": ["B Yekan Regular"],
        "text-size": 13,

        "symbol-placement": "line",
        "text-max-width": 8,
        "symbol-spacing": 400,
        "text-padding": 4
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#f2efe9",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "landuse_name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["!=", ["get", "name"], ""],
      "minzoom": 8,
      "layout": {
        "text-field": "{name}",
        "text-font": ["B Yekan Regular"],
        "text-size": 13,
        "text-anchor": "center",
        "text-justify": "center",
        "symbol-placement": "point",
        "text-max-width": 8,
        "symbol-spacing": 400,
        "text-padding": 4
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#f2efe9",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "park_name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "park",
      "filter": ["!=", ["get", "name"], ""],
      "minzoom": 8,
      "layout": {
        "text-field": "{name}",
        "text-font": ["B Yekan Regular"],
        "text-size": 13,
        "text-anchor": "center",
        "text-justify": "center",
        "symbol-placement": "point",
        "text-max-width": 8,
        "symbol-spacing": 400,
        "text-padding": 4
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#f2efe9",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "landcover_name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["!=", ["get", "name"], ""],
      "minzoom": 8,
      "layout": {
        "text-field": "{name}",
        "text-font": ["B Yekan Regular"],
        "text-size": 13,
        "text-anchor": "center",
        "text-justify": "center",
        "symbol-placement": "point",
        "text-max-width": 8,
        "symbol-spacing": 400,
        "text-padding": 4
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#f2efe9",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "railway_name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "railway",
      "filter": ["!=", ["get", "name"], ""],
      "minzoom": 12,
      "layout": {
        "text-field": "{name}",
        "text-font": ["B Yekan Regular"],
        "text-size": 13,
        "text-anchor": "center",
        "text-justify": "center",
        "symbol-placement": "line",
        "text-max-width": 8,
        "symbol-spacing": 400,
        "text-padding": 4
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#f2efe9",
        "text-halo-width": 1.5
      }
    }
  ],
  "id": "osm-carto-style"
}
